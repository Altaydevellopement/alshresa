# Copiez ce fichier en ".env" pour travailler en local.
# Valeurs à prendre dans Supabase > Project Settings > API (nouveau projet).
# Sur Vercel, ajoutez ces mêmes variables dans Settings > Environment Variables.
VITE_SUPABASE_URL="https://VOTRE_PROJECT_ID.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="votre_cle_anon_ou_publishable"
